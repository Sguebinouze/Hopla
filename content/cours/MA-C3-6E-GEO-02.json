        {
          "type": "vocabulaire",
          "mots": [
            {
              "mot": "Cercle",
              "definition": "Ensemble des points situés à une même distance d’un point appelé centre."
            },
            {
              "mot": "Disque",
              "definition": "Ensemble des points dont la distance au centre est inférieure ou égale au rayon."
            },
            {
              "mot": "Rayon",
              "definition": "Distance entre le centre et un point du cercle. C’est aussi le segment qui les joint."
            },
            {
              "mot": "Diamètre",
              "definition": "Corde qui passe par le centre. Sa longueur vaut deux rayons."
            },
            {
              "mot": "Corde",
              "definition": "Segment qui joint deux points d’un cercle."
            }
          ]
        },
