        {
          "type": "methode",
          "titre": "Pour trouver le groupe sujet",
          "etapes": [
            "Encadre avec « c’est… qui » : ce sont les enfants qui jouent.",
            "Le groupe encadré est le sujet."
          ]
        },
        {
          "type": "question",
          "consigne": "Dans « Le petit chien aboie », le groupe sujet est :",
          "options": [
            "Le petit chien",
            "aboie",
            "petit"
          ],
          "reponse": "Le petit chien",
          "explication": "C’est le petit chien qui aboie."
        }
      ]
    },
