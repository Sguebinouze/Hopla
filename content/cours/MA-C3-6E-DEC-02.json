      "blocs": [
        {
          "type": "observe",
          "consigne": "Calcule 3,45 × 100.",
          "exemples": [
            "3 unités deviennent 3 centaines.",
            "4 dixièmes deviennent 4 dizaines.",
            "5 centièmes deviennent 5 unités.",
            "3,45 × 100 = 345."
          ]
        },
        {
          "type": "explique",
          "texte": "Ce n’est pas la virgule qui se déplace : ce sont les chiffres qui changent de rang. Le résultat est le même que si la virgule glissait vers la droite."
        },
        {
          "type": "piege",
          "erreur": "On ajoute des zéros à droite : 3,45 × 100 = 3,4500.",
          "correction": "3,4500 = 3,45. Ajouter des zéros après la virgule ne multiplie pas. Le bon résultat est 345."
        },
        {
          "type": "question",
          "consigne": "Combien font 0,6 × 1 000 ?",
          "options": [
            "600",
            "0,6000",
            "6"
          ],
          "reponse": "600",
          "explication": "6 dixièmes × 1 000 = 6 centaines."
        }
      ]
    },
    {
      "titre": "Diviser par 10, 100, 1 000",
      "blocs": [
        {
          "type": "methode",
          "titre": "Pour diviser par 10, 100 ou 1 000",
          "etapes": [
            "Compte les zéros du diviseur : 1, 2 ou 3.",
            "Chaque chiffre recule d’autant de rangs vers la droite.",
            "Complète par des zéros si besoin : 72,1 ÷ 1 000 = 0,0721."
          ]
        },
        {
          "type": "question",
          "consigne": "Combien font 58 ÷ 100 ?",
          "options": [
            "0,58",
            "5,8",
            "5 800"
          ],
          "reponse": "0,58",
          "explication": "5 dizaines deviennent 5 dixièmes : 0,58."
        }
      ]
    },
