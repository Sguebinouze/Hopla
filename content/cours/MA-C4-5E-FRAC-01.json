          "type": "exemple-resolu",
          "enonce": "Compare 3/4 et 5/7.",
          "etapes": [
            "Dénominateur commun : 28.",
            "3/4 = 21/28 et 5/7 = 20/28.",
            "21/28 > 20/28."
          ],
          "conclusion": "3/4 > 5/7."
        },
        {
          "type": "piege",
          "erreur": "On additionne les dénominateurs : 1/3 + 1/4 = 2/7.",
          "correction": "On ne peut additionner que des parts de même taille : on passe en douzièmes."
