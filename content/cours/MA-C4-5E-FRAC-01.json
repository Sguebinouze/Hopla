          "titre": "Pour calculer 5/6 − 1/4",
          "etapes": [
            "Cherche un multiple commun à 6 et 4 : 12.",
            "5/6 = 10/12 et 1/4 = 3/12.",
            "10/12 − 3/12 = 7/12."
          ]
        },
        {
          "type": "question",
          "consigne": "1/2 + 1/3 = ?",
          "options": [
            "5/6",
