      "titre": "Nom ou verbe ?",
      "blocs": [
        {
          "type": "observe",
          "consigne": "Le mot avant aide à choisir.",
          "exemples": [
            "un appel, j’appelle",
            "le réveil, il se réveille",
            "le conseil, je conseille",
            "des portes, ils portent"
          ]
        },
        {
          "type": "question",
          "consigne": "Ils … la table. (ranger)",
          "options": [
            "rangent",
            "ranges",
            "rangé"
          ],
          "reponse": "rangent",
          "explication": "Après ils, c’est un verbe : -nt."
        }
      ]
    },
    {
      "titre": "Les marques du pluriel",
      "blocs": [
        {
          "type": "piege",
          "erreur": "On écrit « ils portes ».",
          "correction": "Après ils, c’est un verbe : ils portent."
        }
      ]
    }
  ],
  "a_toi": [
    {
      "consigne": "Les … du jardin. (fleur)",
      "options": [
        "fleurs",
        "fleurent",
        "fleure"
      ],
      "reponse": "fleurs",
      "explication": "Après les, c’est un nom : -s."
    },
