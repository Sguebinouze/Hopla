  "duree": 5,
  "essentiel": "Une égalité à trous cache un nombre : 25 + … = 63.\nPour le trouver, on utilise l’opération inverse : 63 − 25 = 38.\nLes deux membres d’une égalité ont toujours la même valeur.",
  "parties": [
    {
      "titre": "L’opération inverse",
      "blocs": [
        {
          "type": "observe",
          "consigne": "Chaque trou se trouve avec l’opération inverse.",
          "exemples": [
            "25 + … = 63 : 63 − 25 = 38",
            "… − 17 = 30 : 30 + 17 = 47",
            "7 × … = 56 : 56 ÷ 7 = 8"
          ]
        },
        {
          "type": "question",
          "consigne": "6 × … = 42 ?",
          "options": [
            "7",
            "36",
            "48"
          ],
          "reponse": "7",
          "explication": "42 ÷ 6 = 7."
        }
      ]
    },
    {
      "titre": "Un calcul de chaque côté",
      "blocs": [
        {
          "type": "exemple-resolu",
          "enonce": "Complète : 12 + 8 = … + 15.",
          "etapes": [
            "Le membre de gauche vaut 20.",
            "… + 15 = 20, donc … = 5."
          ],
          "conclusion": "12 + 8 = 5 + 15."
        },
        {
          "type": "piege",
          "erreur": "Pour 12 + 8 = … + 15, on écrit 20.",
          "correction": "Le trou n’est pas le résultat. Les deux côtés valent 20 : le trou vaut 5."
        }
      ]
    }
  ],
