{
  "name": "@hopla/pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @hopla/ds build && pnpm --filter @hopla/content packs --brouillons && node scripts/copier-ocr.mjs",
    "dev": "vite",
    "build": "node scripts/copier-ocr.mjs && tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hopla/ds": "workspace:*",
    "@hopla/generateurs": "workspace:*",
    "@hopla/redaction": "workspace:*",
    "@supabase/supabase-js": "^2.49.4",
    "qrcode": "1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/fra": "1.0.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^2.1.8"
  }
}
